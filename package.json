{
  "name": "agriowl-root",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"green,cyan\" \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && .\\venv\\Scripts\\python.exe manage.py runserver",
    "frontend": "npm run dev --prefix frontend",
